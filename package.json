{
  "name": "@kxnzee/a2ui-clarification-ui",
  "version": "0.5.0",
  "private": true,
  "description": "React + Ant Design clarification and metric cards for an existing streamed agent integration",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib",
    "README.md",
    "docs",
    "src/a2ui",
    "dist/agent"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/stream.test.ts tests/processor.test.ts tests/ui.test.tsx tests/request.test.ts tests/agent-export.test.mjs",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "build": "npm run build:demo && npm run build:lib && npm run export:agent",
    "preview": "vite preview --host 127.0.0.1",
    "package:demo": "node scripts/package-demo.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package:a2ui": "node scripts/package-a2ui.mjs",
    "export:agent": "node --import tsx scripts/export-agent.mjs"
  },
  "dependencies": {
    "@a2ui/react": "0.9.1",
    "@a2ui/web_core": "0.11.0",
    "antd": "5.22.5",
    "zod": "4.6.5",
    "zod-a2ui": "npm:zod@3.25.76"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "@a2ui/web_core": "$@a2ui/web_core"
  }
}
